{
  "name": "extension-zed",
  "private": true,
  "version": "2.0.0",
  "packageManager": "bun@1.4.4",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/build.mjs --watch",
    "build": "tsc && bun scripts/build.mjs",
    "lint": "bun run check:tokens && oxlint --deny-warnings src scripts",
    "test": "bun test --isolate",
    "test:e2e": "node scripts/test-extension-e2e.mjs",
    "test:e2e:video-quality": "node scripts/test-video-quality-e2e.mjs",
    "test:e2e:downloader": "node scripts/test-downloader-e2e.mjs",
    "test:e2e:advanced-downloader": "node scripts/test-advanced-downloader-e2e.mjs",
    "check:build": "node scripts/check-build.mjs",
    "package:store": "bun run build && bun run check:build && bun scripts/package-extension.mjs",
    "cws:status": "bun scripts/chrome-web-store-status.mjs",
    "check:tokens": "node scripts/check-tokens.mjs"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "@types/chrome": "^0.2.9",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "minimatch": "11.0.8",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.5.5",
    "fflate": "^0.8.3",
    "oxlint": "^1.94.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
