{
  "name": "extension-zed",
  "private": true,
  "version": "2.0.0",
  "packageManager": "bun@1.4.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && vite build --config vite.content.config.ts && vite build --config vite.content.config.ts --mode shortcuts",
    "lint": "bun run check:tokens && eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "node scripts/test-extension-e2e.mjs",
    "test:e2e:video-quality": "node scripts/test-video-quality-e2e.mjs",
    "check:build": "node scripts/check-build.mjs",
    "package:store": "bun run build && bun run check:build && bun scripts/package-extension.mjs",
    "cws:status": "bun scripts/chrome-web-store-status.mjs",
    "preview": "vite preview",
    "check:tokens": "node scripts/check-tokens.mjs",
    "screenshots": "node scripts/screenshot-design.mjs"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "@types/chrome": "^0.2.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fflate": "^0.8.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
